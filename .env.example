# Environment Variables untuk Pegadaian Scraper API
# Copy file ini ke .env dan sesuaikan nilai-nilainya

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_DEBUG=false

# Scraper Configuration
SCRAPER_TIMEOUT=30
SCRAPER_HEADLESS=true
SCRAPER_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"

# Chrome Configuration (untuk Ubuntu Server)
CHROME_BINARY_PATH=/usr/bin/google-chrome
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Data Storage
DATA_DIR=data
CACHE_ENABLED=true
CACHE_DURATION=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
